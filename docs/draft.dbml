// Тип услуги
Table service_type {
  id int [pk, increment]
  name varchar(255)
}

// Таблица полученных клиентом услуг
Table service {
  id int [pk, increment]
  client_id int
  type_id int

  indexes {
    client_id [name: 'IDX_E19D9AD219EB6921']
    type_id [name: 'IDX_E19D9AD2C54C8C93']
  }
}

// Таблица с услугами, достпуными для регистрации и настройками для них
Table services_registration {
  id int [pk, increment]
  service_type_id int [not null]
  name varchar(255) [not null]
  period_days int [not null]    
  updated_at datetime [default: `CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP`]
}

// Список мест 
Table location {
  id int [pk, increment]
  name varchar(255) [not null]
  address varchar(255)
  created_by_id int
  updated_by_id int
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP`]
}

// Таймслот
Table time_slot {
  id int [pk, increment]
  title varchar(255) [not null]
  type enum('single', 'recurring') [not null]
  location_id int [not null]
  capacity int [not null]
  start_date datetime [not null]
  end_date datetime [not null]
  status enum('active', 'archived') [not null, default: 'active']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP`]

  indexes {
    status [name: 'IDX_time_slot_status']
    (start_date, end_date) [name: 'IDX_time_slot_dates']
  }
}

// Настройки повторения для таймслота
Table time_slot_recurrence {
  time_slot_id int [pk]
  frequency enum('daily', 'weekly', 'monthly') [not null]
  interval int [not null, default: 1]
  end_type enum('never', 'date') [not null]
  end_value datetime
}

// Настройка для услуги, которая оказывается в некоторый таймслот
Table time_slot_service {
  id int [pk, increment]
  time_slot_id int [not null]
  service_type_id int [not null]
  default_capacity int [not null]
  booking_window int [not null]
  default_time time [not null]
}

// Событие создатся на основании настроек повторения для таймслота. 
// Например: для повторяющегося каждую неделю слота на протяжении 4 недель - 
// создатся 4 соыбтия на каждую из недель под каждую из услуг
Table event {
  id int [pk, increment]
  time_slot_service_id int [not null]
  capacity int [not null]
  datetime datetime [not null]
  remaining_capacity int [not null, default: 'capacity'] // Автоматический расчёт
  service_type_id int [not null] // подставляется по триггеру, нужно для денормализации данных
}

