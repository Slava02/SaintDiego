// Список записавшихся на определнное событие
Table event_client {
  id int [pk, increment]
  event_id int [not null]
  client_id int [not null]
  volounteer_id int [not null] // id записавшего волонтера
  status enum('attend', 'absent') [not null, default: 'absent']
}

// Клиент 
Table client {
  id int [pk, not null]
  name varchar(255)
}

// Настройки по клиенту: блокировки
Table client_blocks {
  client_id int [pk, not null]
  blocked_reason text
  blocked_at datetime
}

Table client_group {
  id int pk [not null]
  name varchar(255) [not null]
  updated_at datetime
}

Table client_group_service {
  id int pk [not null]
  group_id int [not null]
  service_registration_id int [not null]
  updated_at datetime
}

Table volounteer {
  id int pk [not null]
}


// References
Ref: service.type_id > service_type.id
Ref: service.client_id > client.id
Ref: time_slot.location_id > location.id
Ref: time_slot_recurrence.time_slot_id > time_slot.id [delete: cascade]
Ref: time_slot_service.time_slot_id > time_slot.id [delete: cascade]
Ref: time_slot_service.service_type_id > services_registration.id
Ref: event.time_slot_service_id > time_slot_service.id
Ref: client.id > event_client.client_id 
Ref: event_client.event_id > event.id
Ref: volounteer.id > event_client.volounteer_id 
Ref: services_registration.service_type_id > service_type.id 
Ref: client_blocks.client_id > client.id
Ref: client_group_service.group_id > client_group.id
Ref: client_group_service.service_registration_id > services_registration.id




